
Enum priority_level {
  low
  medium
  high
}

Enum request_status {
  open
  in_analysis
  approved
  rejected
}

Enum user_role {
  requester
  agent
  supervisor
}

Enum comment_visibility {
  internal
  external
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role user_role [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table areas {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
}

Table requests {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  description text [not null]
  area_id uuid [not null, ref: > areas.id]
  priority priority_level [not null]
  status request_status [not null, default: 'open']
  requester_id uuid [not null, ref: > users.id]
  resolved_by_id uuid [ref: > users.id, note: 'preenchido só quando alguém decide']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'soft delete, LGPD']
}

Table request_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  request_id uuid [not null, ref: > requests.id]
  author_id uuid [not null, ref: > users.id]
  status request_status [not null]
  comment text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table request_comments {
  id uuid [pk, default: `gen_random_uuid()`]
  request_id uuid [not null, ref: > requests.id]
  author_id uuid [not null, ref: > users.id]
  content text [not null]
  visibility comment_visibility [not null, default: 'external']
  created_at timestamptz [not null, default: `now()`]
}
